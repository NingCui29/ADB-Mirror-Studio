<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AdbMirrorStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ADB Mirror Studio">
    <Grid x:Name="RootLayout" Background="{ThemeResource SkySurfaceBrush}" ActualThemeChanged="RootLayout_ActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid Margin="16,0,144,0" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                  ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                       Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="ADB Mirror Studio" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource SkyOnSurfaceBrush}"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Grid.Column="2" FontSize="11"
                           Foreground="{ThemeResource SkyOnSurfaceVariantBrush}"
                           LineHeight="16" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource SkyOutlineVariantBrush}" IsHitTestVisible="False" />
        </Grid>
        <Frame x:Name="RootFrame" Grid.Row="1" Background="Transparent" />
    </Grid>
</Window>
