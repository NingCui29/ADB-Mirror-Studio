<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:AdbMirrorStudio.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AdbMirrorStudio.App.MainPage" Background="{ThemeResource SkySurfaceBrush}">
  <Page.Resources>
    <local:BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    <Style x:Key="SurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource MaterialCardStyle}" />
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialSectionTitleStyle}" />
    <ItemsPanelTemplate x:Key="RailVerticalPanel">
      <StackPanel Orientation="Vertical" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="RailHorizontalPanel">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </Page.Resources>
  <Grid x:Name="WorkbenchShell">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="WideWorkspace">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="CompactWorkspace">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="WorkspaceRailColumn.Width" Value="0" />
            <Setter Target="WorkspaceRow0.Height" Value="Auto" />
            <Setter Target="WorkspaceRow1.Height" Value="*" />
            <Setter Target="DeviceRail.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="DeviceRail.BorderThickness" Value="0,0,0,1" />
            <Setter Target="DeviceRail.Padding" Value="16,12" />
            <Setter Target="PageViews.(Grid.Column)" Value="0" />
            <Setter Target="PageViews.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="PageViews.(Grid.Row)" Value="1" />
            <Setter Target="PageViews.Margin" Value="20,20,20,0" />
            <Setter Target="RailAuxiliaryColumn.Width" Value="Auto" />
            <Setter Target="DeviceRailHeader.Visibility" Value="Collapsed" />
            <Setter Target="DeviceList.(Grid.Row)" Value="0" />
            <Setter Target="DeviceList.MaxHeight" Value="78" />
            <Setter Target="DeviceEmptyHint.(Grid.Row)" Value="0" />
            <Setter Target="DeviceConnectionActions.(Grid.Row)" Value="0" />
            <Setter Target="DeviceConnectionActions.(Grid.Column)" Value="1" />
            <Setter Target="DeviceConnectionActions.Margin" Value="12,0,0,0" />
            <Setter Target="DeviceConnectionActions.VerticalAlignment" Value="Center" />
            <Setter Target="Navigation.(Grid.Row)" Value="1" />
            <Setter Target="Navigation.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="Navigation.Margin" Value="0,10,0,0" />
            <Setter Target="Navigation.ItemsPanel" Value="{StaticResource RailHorizontalPanel}" />
            <Setter Target="RailNavigationRow.Height" Value="Auto" />
            <Setter Target="FooterNavigation.(Grid.Row)" Value="2" />
            <Setter Target="FooterNavigation.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="FooterNavigation.ItemsPanel" Value="{StaticResource RailHorizontalPanel}" />
            <Setter Target="FooterNavigation.Margin" Value="0,4,0,0" />
            <Setter Target="CompactRefreshDevicesButton.Visibility" Value="Visible" />
            <Setter Target="Navigation.(ScrollViewer.HorizontalScrollMode)" Value="Enabled" />
            <Setter Target="Navigation.(ScrollViewer.VerticalScrollMode)" Value="Disabled" />
            <Setter Target="FooterNavigation.(ScrollViewer.HorizontalScrollMode)" Value="Enabled" />
            <Setter Target="FooterNavigation.(ScrollViewer.VerticalScrollMode)" Value="Disabled" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="WideMetrics">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1180" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PerformanceColumn2.Width" Value="*" />
            <Setter Target="PerformanceColumn3.Width" Value="*" />
            <Setter Target="MemoryMetricCard.(Grid.Row)" Value="0" />
            <Setter Target="MemoryMetricCard.(Grid.Column)" Value="2" />
            <Setter Target="DdrMetricCard.(Grid.Row)" Value="0" />
            <Setter Target="DdrMetricCard.(Grid.Column)" Value="3" />
            <Setter Target="PerformanceRow1.Height" Value="0" />
            <Setter Target="CpuMetricCard.Margin" Value="0,0,18,0" />
            <Setter Target="GpuMetricCard.Margin" Value="6,0,12,0" />
            <Setter Target="MemoryMetricCard.Margin" Value="12,0,6,0" />
            <Setter Target="DdrMetricCard.Margin" Value="18,0,0,0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StandardMetrics">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="620" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="MirrorIllustration.Visibility" Value="Collapsed" />
            <Setter Target="MirrorIllustrationColumn.Width" Value="0" />
            <Setter Target="MirrorHeroLayout.ColumnSpacing" Value="0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="NarrowMetrics">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="MirrorIllustration.Visibility" Value="Collapsed" />
            <Setter Target="MirrorIllustrationColumn.Width" Value="0" />
            <Setter Target="PerformanceColumn1.Width" Value="0" />
            <Setter Target="GpuMetricCard.(Grid.Row)" Value="1" />
            <Setter Target="GpuMetricCard.(Grid.Column)" Value="0" />
            <Setter Target="MemoryMetricCard.(Grid.Row)" Value="2" />
            <Setter Target="DdrMetricCard.(Grid.Row)" Value="3" />
            <Setter Target="DdrMetricCard.(Grid.Column)" Value="0" />
            <Setter Target="PerformanceRow2.Height" Value="Auto" />
            <Setter Target="PerformanceRow3.Height" Value="Auto" />
            <Setter Target="DeviceToolbar.(Grid.Row)" Value="1" />
            <Setter Target="DeviceToolbar.(Grid.Column)" Value="0" />
            <Setter Target="DeviceToolbar.HorizontalAlignment" Value="Left" />
            <Setter Target="DeviceToolbarRow.Height" Value="Auto" />
            <Setter Target="DeviceToolbarColumn.Width" Value="0" />
            <Setter Target="DeviceHeader.RowSpacing" Value="12" />
            <Setter Target="CpuMetricCard.Margin" Value="0,0,0,24" />
            <Setter Target="GpuMetricCard.Margin" Value="0,0,0,24" />
            <Setter Target="MemoryMetricCard.Margin" Value="0,0,0,24" />
            <Setter Target="DdrMetricCard.Margin" Value="0" />
            <Setter Target="MirrorHeroLayout.ColumnSpacing" Value="0" />
            <Setter Target="DeviceHeader.ColumnSpacing" Value="0" />
            <Setter Target="MirrorActions.Orientation" Value="Vertical" />
            <Setter Target="MirrorActions.HorizontalAlignment" Value="Left" />
            <Setter Target="ScreenFooterActions.(Grid.Row)" Value="1" />
            <Setter Target="ScreenFooterActions.(Grid.Column)" Value="0" />
            <Setter Target="ScreenFooterActions.HorizontalAlignment" Value="Left" />
            <Setter Target="ScreenFooterActionColumn.Width" Value="0" />
            <Setter Target="ScreenFooterActionRow.Height" Value="Auto" />
            <Setter Target="ScreenFooter.ColumnSpacing" Value="0" />
            <Setter Target="ScreenFooter.RowSpacing" Value="8" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="ExpandedWorkspaceContent">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1440" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="FilesSecondaryColumn.Width" Value="*" />
            <Setter Target="FilesSecondaryRow.Height" Value="0" />
            <Setter Target="FilesCards.RowSpacing" Value="0" />
            <Setter Target="FilesReceiveCard.(Grid.Row)" Value="0" />
            <Setter Target="FilesReceiveCard.(Grid.Column)" Value="1" />
            <Setter Target="AppsSecondaryColumn.Width" Value="*" />
            <Setter Target="AppsSecondaryRow.Height" Value="0" />
            <Setter Target="AppsCards.RowSpacing" Value="0" />
            <Setter Target="AppsManageCard.(Grid.Row)" Value="0" />
            <Setter Target="AppsManageCard.(Grid.Column)" Value="1" />
            <Setter Target="FilesCards.ColumnSpacing" Value="14" />
            <Setter Target="AppsCards.ColumnSpacing" Value="14" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StackedWorkspaceContent">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="WorkspaceRailColumn" Width="228" />
      <ColumnDefinition x:Name="WorkspaceContentColumn" Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="WorkspaceRow0" Height="*" />
      <RowDefinition x:Name="WorkspaceRow1" Height="0" />
    </Grid.RowDefinitions>
    <Border x:Name="DeviceRail" Padding="14,20,14,16" Background="{ThemeResource SkySurfaceContainerLowBrush}" BorderBrush="{ThemeResource SkyOutlineVariantBrush}" BorderThickness="0,0,1,0">
      <Grid x:Name="RailLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="RailAuxiliaryColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="RailNavigationRow" Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="DeviceRailHeader" Margin="8,0,4,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="当前设备" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
            <TextBlock Text="{Binding OnlineSummary}" FontSize="11" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
          </StackPanel>
          <Button x:Name="RefreshDevicesButton" Grid.Column="1" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource MaterialIconButtonStyle}" ToolTipService.ToolTip="刷新设备" AutomationProperties.Name="刷新设备">
            <FontIcon Glyph="" FontSize="16" />
          </Button>
        </Grid>
        <TextBlock x:Name="DeviceEmptyHint" Grid.Row="1" Text="等待设备连接" Margin="10,14" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" Visibility="{Binding HasNoDevices, Converter={StaticResource BooleanVisibility}}" />
        <ListView x:Name="Navigation" Grid.Row="3" SelectionMode="Single" SelectedIndex="0" SelectionChanged="Navigation_SelectionChanged" ItemsPanel="{StaticResource RailVerticalPanel}" ItemContainerStyle="{StaticResource MaterialRailNavigationItemStyle}" Background="Transparent" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="设备功能" ScrollViewer.HorizontalScrollMode="Disabled">
          <ListViewItem x:Name="WorkspaceNavigationItem" Tag="screen" AutomationProperties.Name="屏幕镜像">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="" FontSize="17" />
              <TextBlock Text="屏幕镜像" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem x:Name="FilesNavigationItem" Tag="files" AutomationProperties.Name="文件管理">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="" FontSize="17" />
              <TextBlock Text="文件管理" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem x:Name="AppsNavigationItem" Tag="apps" AutomationProperties.Name="应用管理">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="" FontSize="17" />
              <TextBlock Text="应用管理" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem x:Name="TerminalNavigationItem" Tag="terminal" AutomationProperties.Name="终端">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="" FontSize="17" />
              <TextBlock Text="终端" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
        </ListView>
        <ListView x:Name="FooterNavigation" Grid.Row="4" SelectionMode="Single" SelectionChanged="Navigation_SelectionChanged" ItemsPanel="{StaticResource RailVerticalPanel}" ItemContainerStyle="{StaticResource MaterialRailNavigationItemStyle}" Background="Transparent" Margin="0,20,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="全局功能" ScrollViewer.HorizontalScrollMode="Disabled">
          <ListViewItem x:Name="TasksNavigationItem" Tag="tasks" AutomationProperties.Name="任务中心">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="" FontSize="17" />
              <TextBlock Text="任务中心" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
          <ListViewItem x:Name="SettingsNavigationItem" Tag="settings" AutomationProperties.Name="设置">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="" FontSize="17" />
              <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
        </ListView>
        <ListView Grid.Row="1" ItemsSource="{Binding Devices}" SelectedValuePath="Serial" SelectedValue="{Binding SelectedDeviceSerial, Mode=TwoWay}" SelectionMode="Single" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="目标设备" x:Name="DeviceList" ItemContainerStyle="{StaticResource MaterialDeviceItemStyle}" MaxHeight="200" MinHeight="0">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="10,9" ColumnSpacing="10" AutomationProperties.Name="{Binding DisplayName}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource SkyPrimaryContainerBrush}">
                  <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource SkyOnPrimaryContainerBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="13" ToolTipService.ToolTip="{Binding DisplayName}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{Binding StateIndicatorBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StateLabel}" FontSize="12" />
                    <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,6,0,22" x:Name="DeviceConnectionActions">
          <Button Content="+ 连接设备" HorizontalAlignment="Left" Style="{StaticResource MaterialTextButtonStyle}" x:Name="AddDeviceButton">
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedTop">
                  <ScrollViewer MaxHeight="650" MaxWidth="380" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                      <TextBlock Text="添加设备" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="通过地址连接，或使用 Android 11+ 无线配对" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                      <TextBlock Text="地址连接" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                      <ComboBox x:Name="EndpointBox" Header="无线地址" ItemsSource="{Binding RememberedEndpoints}" Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" PlaceholderText="IP:端口、IPv6 地址或主机名" HorizontalAlignment="Stretch" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="连接" Click="Connect_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource MaterialFilledButtonStyle}" />
                        <Button Content="清除历史" Click="ClearHistory_Click" IsEnabled="{Binding HasRememberedEndpoints}" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                      </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{ThemeResource SkyOutlineVariantBrush}" />
                    <StackPanel Spacing="10">
                      <TextBlock Text="无线配对" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding DiscoveredPairingEndpoints}" Text="{Binding PairEndpoint, Mode=TwoWay}" IsEditable="True" Header="配对地址" PlaceholderText="IP:配对端口" HorizontalAlignment="Stretch" />
                      <PasswordBox x:Name="PairingCodeBox" Header="六位配对码" PasswordChanged="PairingCodeBox_PasswordChanged" />
                      <Button Content="配对" Click="Pair_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource MaterialFilledButtonStyle}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="CompactRefreshDevicesButton" Visibility="Collapsed" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource MaterialIconButtonStyle}" AutomationProperties.Name="刷新设备" ToolTipService.ToolTip="刷新设备">
            <FontIcon Glyph="" FontSize="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="PageViews" Grid.Column="1" Margin="28,26,28,0" MaxWidth="1400" HorizontalAlignment="Stretch">
      <Grid x:Name="WorkspaceView" RowSpacing="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DeviceHeader" ColumnSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="DeviceToolbarRow" Height="0" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DeviceToolbarColumn" Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="5">
            <TextBlock x:Name="WorkspaceTitle" Text="屏幕镜像" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="WorkspaceDescription" Text="查看画面，直接用键盘和鼠标控制。" FontSize="13" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="DeviceToolbar" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BooleanVisibility}}">
            <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" VerticalAlignment="Center" />
            <Button Click="SaveScreenshot_Click" IsEnabled="{Binding CanUseSelectedDevice}" Style="{StaticResource MaterialOutlinedButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="" FontSize="16" />
                <TextBlock Text="截图" />
              </StackPanel>
            </Button>
            <Button x:Name="DeviceMoreButton" AutomationProperties.Name="更多设备操作" ToolTipService.ToolTip="更多设备操作" Style="{StaticResource MaterialIconButtonStyle}">
              <FontIcon Glyph="" FontSize="16" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="设备详情" Click="DeviceDetails_Click" CommandParameter="{Binding SelectedDeviceSerial}" IsEnabled="{Binding CanUseSelectedDevice}" />
                  <MenuFlyoutItem Text="启用 TCP/IP" Click="EnableTcpIp_Click" CommandParameter="{Binding SelectedDeviceSerial}" IsEnabled="{Binding CanUseSelectedDevice}" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="重启设备" Click="Reboot_Click" CommandParameter="{Binding SelectedDeviceSerial}" IsEnabled="{Binding CanUseSelectedDevice}" />
                  <MenuFlyoutItem Text="断开连接" Click="Disconnect_Click" CommandParameter="{Binding SelectedDeviceSerial}" IsEnabled="{Binding CanUseSelectedDevice}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
        <Grid x:Name="WorkspacePanels" Grid.Row="1" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BooleanVisibility}}">
          <ScrollViewer x:Name="ScreenScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Visible" Padding="0,0,0,24">
            <StackPanel x:Name="ScreenCards" Spacing="22" HorizontalAlignment="Stretch">
              <Border x:Name="MirrorLaunchCard" Style="{StaticResource SurfaceCardStyle}" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                  <Grid Padding="28" ColumnSpacing="28" x:Name="MirrorHeroLayout">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition x:Name="MirrorIllustrationColumn" Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="0">
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,15,14">
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SkySuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedMirrorStatusText}" FontSize="12" Foreground="{ThemeResource SkySuccessBrush}" />
                      </StackPanel>
                      <TextBlock Text="{Binding SelectedMirrorHeadline}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SelectedMirrorDescription}" FontSize="13" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" Margin="0,8,0,24" TextWrapping="Wrap" />
                      <StackPanel x:Name="MirrorActions" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="MirrorActionButton" Content="{Binding SelectedMirrorActionText}" Click="MirrorAction_Click" CommandParameter="{Binding SelectedDeviceSerial}" IsEnabled="{Binding CanUseSelectedDevice}" Style="{StaticResource MaterialFilledButtonStyle}" MinWidth="124" />
                        <Button x:Name="MirrorSettingsButton" Content="镜像设置 ›" Style="{StaticResource MaterialTextButtonStyle}">
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                              <StackPanel x:Name="MirrorSettingsContent" MaxWidth="340" Spacing="16">
                                <TextBlock Text="镜像设置" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="画质与录制选项将在下一次启动镜像时生效。" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                                <TextBox Header="启动时录制（可选）" Text="{Binding RecordingPath, Mode=TwoWay}" PlaceholderText="选择 .mkv 或 .mp4 文件" IsReadOnly="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <Button Content="选择录制文件" Click="ChooseRecordingPath_Click" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                                  <Button Content="清除" Click="ClearRecordingPath_Click" Style="{StaticResource MaterialTextButtonStyle}" />
                                </StackPanel>
                                <Button Content="查看运行会话与录屏文件" Click="OpenTasks_Click" Style="{StaticResource MaterialTextButtonStyle}" HorizontalAlignment="Left" />
                              </StackPanel>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                    <Grid x:Name="MirrorIllustration" Grid.Column="1" Height="170" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                      <Border Width="174" Height="112" Margin="0,0,24,18" Background="{ThemeResource SkySurfaceContainerLowBrush}" BorderBrush="{ThemeResource SkyOutlineVariantBrush}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="19" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0" VerticalAlignment="Center">
                            <Ellipse Width="3" Height="3" Fill="{ThemeResource SkyOutlineBrush}" />
                            <Ellipse Width="3" Height="3" Fill="{ThemeResource SkyOutlineBrush}" />
                            <Ellipse Width="3" Height="3" Fill="{ThemeResource SkyOutlineBrush}" />
                          </StackPanel>
                          <Border Grid.Row="1" CornerRadius="0,0,8,8" Background="{ThemeResource SkyPrimaryContainerBrush}" Padding="18">
                            <FontIcon Glyph="" FontSize="38" Foreground="{ThemeResource SkyPrimaryBrush}" />
                          </Border>
                        </Grid>
                      </Border>
                      <Border Width="48" Height="92" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,20" BorderThickness="3" BorderBrush="{ThemeResource SkyOnSurfaceBrush}" Background="{ThemeResource SkyPrimaryContainerBrush}" CornerRadius="10">
                        <Grid>
                          <Border Width="14" Height="3" Background="{ThemeResource SkyOnSurfaceBrush}" CornerRadius="0,0,4,4" VerticalAlignment="Top" />
                          <Rectangle Height="3" Width="16" Fill="{ThemeResource SkyOnSurfaceBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" Opacity="0.35" />
                        </Grid>
                      </Border>
                      <TextBlock Text="独立镜像窗口" FontSize="11" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </Grid>
                  </Grid>
                  <Border BorderBrush="{ThemeResource SkyOutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="画质" FontSize="13" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="{ThemeResource SkySurfaceContainerLowBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                        <ListView x:Name="MirrorProfileSelector" ItemsSource="{Binding MirrorProfiles}" SelectedValuePath="Id" SelectedValue="{Binding SelectedMirrorProfileId, Mode=TwoWay}" SelectionMode="Single" SelectionChanged="MirrorProfileSelector_SelectionChanged" ItemContainerStyle="{StaticResource MaterialPresetItemStyle}" ItemsPanel="{StaticResource RailHorizontalPanel}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="画质预设" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
                          <ListView.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Name}" FontSize="13" />
                            </DataTemplate>
                          </ListView.ItemTemplate>
                        </ListView>
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top" x:Name="PerformanceCard" Padding="24">
                <StackPanel Spacing="20">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="性能监测" TextWrapping="Wrap" Style="{StaticResource SectionTitleStyle}" />
                      <TextBlock Text="整机 · 实时数据与最近 30 秒均值" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" FontWeight="Normal" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PerformanceMonitoringToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="开启" OffContent="关闭" AutomationProperties.Name="性能监测" Toggled="PerformanceMonitoringToggle_Toggled" />
                  </Grid>
                  <StackPanel x:Name="PerformanceMetricsPanel" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="0" RowSpacing="0" x:Name="PerformanceGrid">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" x:Name="PerformanceColumn1" />
                        <ColumnDefinition x:Name="PerformanceColumn2" Width="0" />
                        <ColumnDefinition x:Name="PerformanceColumn3" Width="0" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" x:Name="PerformanceRow1" />
                        <RowDefinition x:Name="PerformanceRow2" Height="0" />
                        <RowDefinition x:Name="PerformanceRow3" Height="0" />
                      </Grid.RowDefinitions>
                      <Border Padding="0" CornerRadius="0" Background="Transparent" x:Name="CpuMetricCard" VerticalAlignment="Top" Margin="0,0,12,24">
                        <StackPanel Spacing="4">
                          <TextBlock Text="CPU" FontWeight="Normal" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                          <TextBlock Text="{Binding CpuUsageText}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,6" />
                          <ProgressBar Value="{Binding CpuUsagePercent}" Minimum="0" Maximum="100" Height="3" Margin="0,4,0,10" Background="{ThemeResource SkySurfaceContainerLowBrush}" AutomationProperties.Name="Cpu 使用率" />
                          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}">
                            <Run Text="30 秒平均 " />
                            <Run Text="{Binding CpuAverageText}" />
                          </TextBlock>
                          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}">
                            <Run Text="温度（最高热区） " />
                            <Run Text="{Binding CpuTemperatureText}" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Padding="0" CornerRadius="0" Background="Transparent" x:Name="GpuMetricCard" VerticalAlignment="Top" Margin="12,0,0,24">
                        <StackPanel Spacing="4">
                          <TextBlock Text="GPU" FontWeight="Normal" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                          <TextBlock Text="{Binding GpuUsageText}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,6" />
                          <ProgressBar Value="{Binding GpuUsagePercent}" Minimum="0" Maximum="100" Height="3" Margin="0,4,0,10" Background="{ThemeResource SkySurfaceContainerLowBrush}" AutomationProperties.Name="Gpu 使用率" />
                          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}">
                            <Run Text="30 秒平均 " />
                            <Run Text="{Binding GpuAverageText}" />
                          </TextBlock>
                          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}">
                            <Run Text="温度 " />
                            <Run Text="{Binding GpuTemperatureText}" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="1" Padding="0" CornerRadius="0" Background="Transparent" x:Name="MemoryMetricCard" VerticalAlignment="Top" Margin="0,0,12,0">
                        <StackPanel Spacing="4">
                          <TextBlock Text="内存" FontWeight="Normal" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                          <TextBlock Text="{Binding MemoryUsageText}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,6" />
                          <ProgressBar Value="{Binding MemoryUsagePercent}" Minimum="0" Maximum="100" Height="3" Margin="0,4,0,10" Background="{ThemeResource SkySurfaceContainerLowBrush}" AutomationProperties.Name="Memory 使用率" />
                          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}">
                            <Run Text="30 秒平均 " />
                            <Run Text="{Binding MemoryAverageText}" />
                          </TextBlock>
                          <TextBlock Text="{Binding MemoryDetailText}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="1" Grid.Column="1" Padding="0" CornerRadius="0" Background="Transparent" x:Name="DdrMetricCard" VerticalAlignment="Top" Margin="12,0,0,0">
                        <StackPanel Spacing="4">
                          <TextBlock Text="DDR 带宽" FontWeight="Normal" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                          <TextBlock Text="{Binding DdrUsageText}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,6" />
                          <ProgressBar Value="{Binding DdrUsagePercent}" Minimum="0" Maximum="100" Height="3" Margin="0,4,0,10" Background="{ThemeResource SkySurfaceContainerLowBrush}" AutomationProperties.Name="Ddr 使用率" />
                          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}">
                            <Run Text="30 秒平均 " />
                            <Run Text="{Binding DdrAverageText}" />
                          </TextBlock>
                          <TextBlock Text="{Binding DdrFrequencyText}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding PerformanceHint}" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                  </StackPanel>
                  <Border x:Name="PerformanceDisabledHint" Padding="0" Background="Transparent" CornerRadius="10">
                    <TextBlock Text="开启性能监测后，查看当前设备的实时占用、温度与最近 30 秒平均值。" Style="{StaticResource MaterialBodyStyle}" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                  </Border>
                </StackPanel>
              </Border>
              <Grid x:Name="ScreenFooter" ColumnSpacing="12" RowSpacing="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition x:Name="ScreenFooterActionRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition x:Name="ScreenFooterActionColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="镜像窗口支持键盘与鼠标控制" FontSize="12" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="ScreenFooterActions" Content="查看会话与录屏文件 ↗" Click="OpenTasks_Click" Grid.Column="1" Style="{StaticResource MaterialTextButtonStyle}" />
              </Grid>
              <Expander x:Name="DeviceControlsExpander" Header="设备快捷控制" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                  <AppBarButton Label="返回" Tag="4" Click="DeviceKey_Click" IsEnabled="{Binding CanUseSelectedDevice}" Icon="Back" />
                  <AppBarButton Label="主页" Tag="3" Click="DeviceKey_Click" IsEnabled="{Binding CanUseSelectedDevice}" Icon="Home" />
                  <AppBarButton Label="最近任务" Tag="187" Click="DeviceKey_Click" IsEnabled="{Binding CanUseSelectedDevice}" Icon="BrowsePhotos" />
                  <AppBarSeparator />
                  <AppBarButton Label="电源" Tag="26" Click="DeviceKey_Click" IsEnabled="{Binding CanUseSelectedDevice}">
                    <AppBarButton.Icon>
                      <FontIcon Glyph="" />
                    </AppBarButton.Icon>
                  </AppBarButton>
                  <AppBarButton Label="音量+" Tag="24" Click="DeviceKey_Click" IsEnabled="{Binding CanUseSelectedDevice}" Icon="Volume" />
                  <AppBarButton Label="音量-" Tag="25" Click="DeviceKey_Click" IsEnabled="{Binding CanUseSelectedDevice}" Icon="Mute" />
                  <AppBarSeparator />
                </CommandBar>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="FilesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed" Padding="0,0,0,24">
            <Grid x:Name="FilesCards" Margin="0" ColumnSpacing="0" RowSpacing="14" MaxWidth="1400" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="FilesSecondaryColumn" Width="0" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="FilesSecondaryRow" Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" AllowDrop="True" DragOver="FileDrop_DragOver" Drop="FileDrop_Drop" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="发送到设备" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="选择多个文件或直接拖入，默认发送到 /sdcard/Download/" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Padding="20" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource SkyOutlineVariantBrush}" Background="{ThemeResource SkySurfaceContainerLowBrush}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                      <FontIcon Glyph="" FontSize="28" Foreground="{ThemeResource SkyPrimaryBrush}" />
                      <TextBlock Text="将文件拖到这里" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="也可以使用下方的“选择文件”" Style="{StaticResource MaterialCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <TextBox Text="{Binding TransferFilePath, Mode=TwoWay}" IsReadOnly="True" PlaceholderText="尚未选择文件" />
                  <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="选择文件" Click="ChooseFile_Click" Style="{StaticResource MaterialOutlinedButtonStyle}" Grid.Column="0" HorizontalAlignment="Stretch" Padding="10,10" />
                    <Button Content="开始发送" Click="PushFile_Click" Style="{StaticResource MaterialFilledButtonStyle}" IsEnabled="{Binding CanPushFiles}" Grid.Column="1" HorizontalAlignment="Stretch" Padding="10,10" />
                    <Button Content="取消" Click="CancelTransfer_Click" Style="{StaticResource MaterialOutlinedButtonStyle}" Grid.Column="2" HorizontalAlignment="Stretch" Padding="10,10" />
                  </Grid>
                  <Button Content="查看传输队列 →" Click="OpenTasks_Click" Style="{StaticResource MaterialTextButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border x:Name="FilesReceiveCard" Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="从设备获取" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="输入设备上的文件路径并选择电脑保存目录" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox Header="设备文件路径" Text="{Binding RemoteFilePath, Mode=TwoWay}" PlaceholderText="/sdcard/Download/example.zip" />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="电脑保存目录" Text="{Binding LocalDownloadDirectory, Mode=TwoWay}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="选择目录" Click="ChooseDownloadDirectory_Click" VerticalAlignment="Bottom" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                  </Grid>
                  <Button Content="开始获取" Click="PullRemoteFile_Click" Style="{StaticResource MaterialFilledButtonStyle}" IsEnabled="{Binding CanUseSelectedDevice}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
          <ScrollViewer x:Name="AppsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed" Padding="0,0,0,24">
            <Grid x:Name="AppsCards" Margin="0" ColumnSpacing="0" RowSpacing="14" MaxWidth="1400" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AppsSecondaryColumn" Width="0" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="AppsSecondaryRow" Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                  <TextBlock Text="安装 APK" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ApkFilePath, Mode=TwoWay}" IsReadOnly="True" PlaceholderText="选择 .apk 文件" />
                    <Button Grid.Column="1" Content="选择 APK" Click="ChooseApk_Click" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                  </Grid>
                  <Button Content="安装到当前设备" Click="InstallApk_Click" Style="{StaticResource MaterialFilledButtonStyle}" IsEnabled="{Binding CanInstallApk}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border x:Name="AppsManageCard" Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                  <TextBlock Text="管理应用" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                  <TextBlock Text="读取用户应用后选择目标包名。卸载前会再次确认。" Style="{StaticResource MaterialBodyStyle}" TextWrapping="Wrap" />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding InstalledApps}" DisplayMemberPath="PackageName" SelectedValuePath="PackageName" SelectedValue="{Binding SelectedAppPackage, Mode=TwoWay}" PlaceholderText="读取设备应用后选择包名" />
                    <Button Grid.Column="1" Content="读取用户应用" Click="RefreshApps_Click" IsEnabled="{Binding CanUseSelectedDevice}" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                  </Grid>
                  <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                    <AppBarButton Label="启动" Tag="launch" Click="AppAction_Click" IsEnabled="{Binding CanRunSelectedAppAction}" Icon="Play" />
                    <AppBarButton Label="强制停止" Tag="stop" Click="AppAction_Click" IsEnabled="{Binding CanRunSelectedAppAction}" Icon="Stop" />
                    <AppBarButton Label="卸载" Tag="uninstall" Click="AppAction_Click" IsEnabled="{Binding CanRunSelectedAppAction}" Icon="Delete" />
                  </CommandBar>
                  <Expander Header="按包名管理（高级）" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Padding="0,10,0,0" Spacing="8">
                      <TextBox Text="{Binding PackageNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如 com.example.app" />
                      <Button Content="卸载指定包名" Click="UninstallPackage_Click" HorizontalAlignment="Left" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
          <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed" Padding="0,0,0,24">
            <StackPanel x:Name="TerminalContent" Margin="0" Spacing="14" MaxWidth="1400" HorizontalAlignment="Stretch">
              <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="ADB Shell" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="直接输入 Android Shell 命令，无需 adb shell 前缀。执行前会再次确认目标和内容。" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                  </StackPanel>
                  <TextBox Header="设备命令" Text="{Binding ShellCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如 pm list packages com.tp" />
                  <TextBlock Text="查询包名：pm list packages com.tp。此处不是 Windows CMD，不能使用 findstr；也可使用设备端 grep 过滤输出。" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                  <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="执行" Click="RunShellCommand_Click" Style="{StaticResource MaterialFilledButtonStyle}" IsEnabled="{Binding CanUseSelectedDevice}" Grid.Column="0" HorizontalAlignment="Stretch" Padding="10,10" />
                    <Button Content="取消" Click="CancelShellCommand_Click" IsEnabled="{Binding IsShellCommandRunning}" Style="{StaticResource MaterialOutlinedButtonStyle}" Grid.Column="1" HorizontalAlignment="Stretch" Padding="10,10" />
                    <Button Content="清空" Click="ClearShellOutput_Click" Style="{StaticResource MaterialOutlinedButtonStyle}" Grid.Column="2" HorizontalAlignment="Stretch" Padding="10,10" />
                    <Button Content="导出 Logcat" Click="ExportLogcat_Click" IsEnabled="{Binding CanUseSelectedDevice}" Style="{StaticResource MaterialOutlinedButtonStyle}" Grid.Column="3" HorizontalAlignment="Stretch" Padding="10,10" />
                  </Grid>
                  <TextBox Text="{Binding ShellOutput}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" MinHeight="230" MaxHeight="430" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{ThemeResource SkySurfaceContainerLowBrush}" Padding="16" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="EmptyWorkspace" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BooleanVisibility}, ConverterParameter=Invert}">
          <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Stretch" Padding="0,0,4,12">
            <Border Background="{ThemeResource SkyPrimaryContainerBrush}" CornerRadius="16" Padding="24">
              <StackPanel Spacing="16">
                <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Left" Background="{ThemeResource SkyPrimaryBrush}">
                  <FontIcon Glyph="" FontSize="30" Foreground="{ThemeResource SkyOnPrimaryBrush}" />
                </Border>
                <TextBlock Text="连接设备，开始工作" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource SkyOnPrimaryContainerBrush}" TextWrapping="Wrap" />
                <TextBlock Text="在电脑上查看屏幕、传输文件和管理应用。连接后，在设备列表中选择要操作的设备。" Foreground="{ThemeResource SkyOnPrimaryContainerBrush}" TextWrapping="Wrap" FontSize="15" MaxWidth="640" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="添加无线设备" Click="OpenAddDevice_Click" Style="{StaticResource MaterialFilledButtonStyle}" />
                  <Button Content="重新扫描" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource MaterialOutlinedButtonStyle}" Foreground="{ThemeResource SkyOnPrimaryContainerBrush}" BorderBrush="{ThemeResource SkyOnPrimaryContainerBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
              <StackPanel Spacing="18">
                <TextBlock Text="通过 USB 连接" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource SkySecondaryContainerBrush}">
                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SkyOnSecondaryContainerBrush}" TextWrapping="Wrap" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="开启 USB 调试" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="在 Android 的开发者选项中开启 USB 调试。" Style="{StaticResource MaterialBodyStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource SkySecondaryContainerBrush}">
                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SkyOnSecondaryContainerBrush}" TextWrapping="Wrap" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="连接并允许调试" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="使用数据线连接电脑，在设备上允许 USB 调试授权。" Style="{StaticResource MaterialBodyStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <Button Content="设备未出现？打开诊断" Click="OpenDiagnostics_Click" Style="{StaticResource MaterialTextButtonStyle}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="TasksView" Margin="0" Visibility="Collapsed" MaxWidth="1400" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="任务中心" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="集中查看跨设备会话、传输进度和已生成文件" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
            <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock Text="镜像会话" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="多设备镜像、录屏和窗口排列" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed">
                    <AppBarButton Icon="ViewAll" Label="网格" Tag="grid" Click="ArrangeWindows_Click" IsEnabled="{Binding CanArrangeMirrorWindows}" />
                    <AppBarButton Icon="DockLeft" Label="横向" Tag="horizontal" Click="ArrangeWindows_Click" IsEnabled="{Binding CanArrangeMirrorWindows}" />
                    <AppBarButton Icon="DockBottom" Label="纵向" Tag="vertical" Click="ArrangeWindows_Click" IsEnabled="{Binding CanArrangeMirrorWindows}" />
                  </CommandBar>
                </Grid>
                <InfoBar IsOpen="{Binding HasNoSessions}" IsClosable="False" Severity="Informational" Title="没有运行中的镜像会话" />
                <ItemsControl ItemsSource="{Binding Sessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="14" Margin="0,0,0,8" CornerRadius="16" Background="{ThemeResource SkySurfaceContainerLowBrush}">
                        <Grid ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding DeviceDisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PerformanceLabel}" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                            <TextBlock Text="{Binding RecordingLabel}" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="{Binding RecordingButtonText}" Click="ToggleSessionRecording_Click" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                            <Button Content="停止" Click="StopMirror_Click" CommandParameter="{Binding DeviceSerial}" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <TextBlock Text="文件任务" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                <InfoBar IsOpen="{Binding HasNoTransferTasks}" IsClosable="False" Severity="Informational" Title="当前没有文件任务" />
                <ItemsControl ItemsSource="{Binding TransferQueue}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <TextBlock Text="录屏文件" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                <InfoBar IsOpen="{Binding HasNoRecordings}" IsClosable="False" Severity="Informational" Title="当前没有录屏文件" />
                <ItemsControl ItemsSource="{Binding Recordings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Status}" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开目录" Click="OpenRecordingDirectory_Click" CommandParameter="{Binding Path}" VerticalAlignment="Center" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="SettingsView" Margin="0" Visibility="Collapsed" MaxWidth="1400" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="设置中心" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="管理应用偏好、连接记录、系统健康和版本" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">
            <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
              <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                  <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                  <RadioButtons x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged">
                    <x:String>跟随系统</x:String>
                    <x:String>浅色</x:String>
                    <x:String>深色</x:String>
                  </RadioButtons>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                  <TextBlock Text="设备刷新" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                  <TextBlock Text="定期更新设备在线状态，执行任务时自动避让" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                  <ToggleSwitch x:Name="AutoRefreshToggle" OnContent="开启" OffContent="关闭" Toggled="AutoRefreshToggle_Toggled" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" x:Name="DiagnosticsCard" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock Text="系统健康" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="检查 ADB、scrcpy、mDNS 和潜在版本冲突" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="RunDiagnosticsButton" Grid.Column="1" Content="运行诊断" Click="RunDiagnostics_Click" Style="{StaticResource MaterialFilledButtonStyle}" IsEnabled="{Binding IsIdle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="8,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{Binding Glyph}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding StateLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <TextBlock Text="更新" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgress}" Height="4" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Content="检查更新" Click="CheckUpdates_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource MaterialOutlinedButtonStyle}" Grid.Column="0" HorizontalAlignment="Stretch" Padding="10,10" />
                  <Button Content="下载并安装" Click="DownloadAndInstallUpdate_Click" IsEnabled="{Binding CanDownloadAndInstallUpdate}" Style="{StaticResource MaterialFilledButtonStyle}" Grid.Column="1" HorizontalAlignment="Stretch" Padding="10,10" />
                  <Button Content="取消下载" Click="CancelUpdateDownload_Click" IsEnabled="{Binding IsUpdateDownloading}" Style="{StaticResource MaterialOutlinedButtonStyle}" Grid.Column="2" HorizontalAlignment="Stretch" Padding="10,10" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <TextBlock Text="本地数据与关于" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DataDirectory}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="打开数据目录" Click="OpenDataDirectory_Click" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                  <Button Content="清除连接历史" Click="ClearHistory_Click" IsEnabled="{Binding HasRememberedEndpoints}" Style="{StaticResource MaterialOutlinedButtonStyle}" />
                </StackPanel>
                <TextBlock>
                  <Run Text="ADB Mirror Studio " />
                  <Run Text="{Binding AppVersion}" />
                </TextBlock>
                <TextBlock Text="全部功能免费；ADB 与 scrcpy 使用 Apache-2.0，其他第三方许可随发布包提供。" TextWrapping="Wrap" Foreground="{ThemeResource SkyOnSurfaceVariantBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <InfoBar Margin="24" IsOpen="{Binding IsStatusOpen, Mode=TwoWay}" IsClosable="True" Severity="{Binding StatusSeverity}" Title="" Message="{Binding StatusText}" AutomationProperties.LiveSetting="Polite" CornerRadius="12" ToolTipService.ToolTip="右键可复制状态或打开诊断" x:Name="StatusNotification" Grid.ColumnSpan="2" Grid.RowSpan="2" MaxWidth="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{ThemeResource SkySurfaceContainerLowestBrush}" BorderBrush="{ThemeResource SkyOutlineVariantBrush}" BorderThickness="1">
      <InfoBar.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutItem Text="复制状态" Click="CopyStatus_Click" />
          <MenuFlyoutItem Text="打开诊断" Click="OpenDiagnostics_Click" />
        </MenuFlyout>
      </InfoBar.ContextFlyout>
    </InfoBar>
  </Grid>
</Page>
